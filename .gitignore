cat << 'EOF' > .gitignore
# Environments & Virtual Envs
venv/
env/
ENV/
.env

# Python Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data & PDF files (dla prywatności i oszczędności miejsca w Git)
data/*/*.pdf
data/*/*.json
!data/.gitkeep

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# Docker Data
mongo_data/

# OS Specific
.DS_Store
Thumbs.db
EOF
.aider*
